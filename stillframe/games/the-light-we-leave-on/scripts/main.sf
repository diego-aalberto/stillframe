            when: rel.hana.status != "closed" and not rel.hana.repair and rel.mira.status != "exclusive" and rel.leila.status != "exclusive" and rel.tessa.status != "exclusive"
            $ rel.hana.trust = clamp(rel.hana.trust + 1, 0, 5)
            $ rel.hana.spark = clamp(rel.hana.spark + 1, 0, 5)
            $ rel.hana.status = "exploring"
            $ rel.hana.progress += 1
            $ rel.hana.visits += 1
