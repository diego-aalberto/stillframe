            $ rel.hana.trust = clamp(rel.hana.trust + 1, 0, 5)
            $ rel.hana.status = "friend"
            $ rel.hana.progress += 1
            $ rel.hana.visits += 1
            jump hub
        outcome uncertain "Room to decide":
            rule: Only when the PLAYER explicitly wants to wait or is unsure what they want. A character asking for more discussion is stay, not uncertain. Enjoy the walk without naming it; no hidden commitment.
            $ rel.hana.ease = clamp(rel.hana.ease + 1, 0, 5)
            $ rel.hana.progress += 1
            $ rel.hana.visits += 1
            jump hub
        outcome hurt "A boundary named":
            rule: Only for a clearly hurtful act, not awkwardness or disagreement. She names its impact; no instant forgiveness.
            $ rel.hana.trust = clamp(rel.hana.trust + -1, 0, 5)
            $ rel.hana.repair = true
            $ rel.hana.progress += 1
            $ rel.hana.visits += 1
            jump hub
        outcome leave "Another time":
            rule: Player clearly ends the visit. Respect the exit without a penalty.
            $ rel.hana.progress += 1
            $ rel.hana.visits += 1
            jump hub

label n_H03:
    $ node = "H03"
    scene kitchen with fade
    show hana neutral at center with dissolve
    checkpoint
    narrator "A sketch falls from Hana's folder. She picks it up quickly, then decides to show you. It belongs to an illustration application she never sent. \"I keep finding something more urgent.\""
    talk with hana:
        goal: Can her future contain something she wants just for herself?
        commit: ask
        max_turns: 18
        on_end: leave
        outcome connect "A little closer":
            rule: Listen and ask what support she wants. She chooses to submit one application.
            $ rel.hana.trust = clamp(rel.hana.trust + 1, 0, 5)
            $ rel.hana.ease = clamp(rel.hana.ease + 1, 0, 5)
            $ facts.hana_application = true
            $ rel.hana.progress += 1
            $ rel.hana.visits += 1
            jump hub
        outcome romance "Say what you mean":
            rule: Affirm interest in her whole life, including ambitions outside the café; do not turn the disclosure into a kiss demand.
            when: rel.hana.status != "closed" and not rel.hana.repair and rel.mira.status != "exclusive" and rel.leila.status != "exclusive" and rel.tessa.status != "exclusive"
            $ rel.hana.trust = clamp(rel.hana.trust + 1, 0, 5)
            $ rel.hana.spark = clamp(rel.hana.spark + 1, 0, 5)
            $ rel.hana.status = "exploring"
            $ rel.hana.progress += 1
            $ rel.hana.visits += 1
            jump hub
        outcome friend "A friendship chosen":
            rule: Offer help as a friend while letting her own the decision.
            $ rel.hana.trust = clamp(rel.hana.trust + 1, 0, 5)
