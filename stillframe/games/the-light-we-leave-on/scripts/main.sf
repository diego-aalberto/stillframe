# The Light We Leave On - generated by tools/port_legacy_story.py from the legacy story data.
# Relationship state lives in `rel.<who>`; story flags in `flags`; secrets revealed in `facts`.

label start:
    scene car with fade
    narrator "Six summer weeks in Bellweather. A flooded bus stop, a borrowed lift, and a café that might not be there much longer."
    jump n_S01

label hub:
    menu:
        narrator "The room settles. What would you like to do with this stretch of the evening?"
        "Spend time with Hana" if visits < 4 and rel.hana.status != "closed" and (rel.hana.repair or rel.hana.progress < min(6, stage)):
            jump visit_hana
        "Spend time with Mira" if visits < 4 and rel.mira.status != "closed" and (rel.mira.repair or rel.mira.progress < min(6, stage)):
            jump visit_mira
        "Spend time with Leila" if visits < 4 and rel.leila.status != "closed" and (rel.leila.repair or rel.leila.progress < min(6, stage)):
            jump visit_leila
        "Spend time with Tessa" if visits < 4 and rel.tessa.status != "closed" and (rel.tessa.repair or rel.tessa.progress < min(6, stage)):
            jump visit_tessa
        "Let the story move on":
            jump advance

label visit_hana:
    $ visits += 1
    if rel.hana.repair:
        jump n_REPAIR_hana
    if rel.hana.progress == 0:
        jump n_H01
    if rel.hana.progress == 1:
        jump n_H02
    if rel.hana.progress == 2:
        jump n_H03
    if rel.hana.progress == 3:
        jump n_H04
    if rel.hana.progress == 4:
        jump n_H05
    if rel.hana.progress == 5:
        jump n_H06
    jump hub

label visit_mira:
    $ visits += 1
    if rel.mira.repair:
        jump n_REPAIR_mira
    if rel.mira.progress == 0:
        jump n_M01
    if rel.mira.progress == 1:
        jump n_M02
    if rel.mira.progress == 2:
        jump n_M03
    if rel.mira.progress == 3:
        jump n_M04
    if rel.mira.progress == 4:
        jump n_M05
    if rel.mira.progress == 5:
        jump n_M06
    jump hub

label visit_leila:
    $ visits += 1
    if rel.leila.repair:
        jump n_REPAIR_leila
    if rel.leila.progress == 0:
        jump n_L01
    if rel.leila.progress == 1:
        jump n_L02
    if rel.leila.progress == 2:
        jump n_L03
    if rel.leila.progress == 3:
        jump n_L04
    if rel.leila.progress == 4:
        jump n_L05
    if rel.leila.progress == 5:
        jump n_L06
    jump hub

label visit_tessa:
    $ visits += 1
    if rel.tessa.repair:
        jump n_REPAIR_tessa
    if rel.tessa.progress == 0:
        jump n_T01
    if rel.tessa.progress == 1:
        jump n_T02
    if rel.tessa.progress == 2:
        jump n_T03
    if rel.tessa.progress == 3:
        jump n_T04
    if rel.tessa.progress == 4:
        jump n_T05
    if rel.tessa.progress == 5:
        jump n_T06
    jump hub

label advance:
    if shared_index == 8 and not flags.g01_done and rel.hana.status == "shared" and not rel.hana.repair and rel.mira.status == "shared" and not rel.mira.repair and rel.leila.status == "shared" and not rel.leila.repair and rel.tessa.status == "shared" and not rel.tessa.repair:
        jump n_G01
    $ shared_index += 1
    $ visits = 0
    if shared_index == 1:
        jump n_S02
    if shared_index == 2:
        jump n_S03
    if shared_index == 3:
        jump n_S04
    if shared_index == 4:
        jump n_S05
    if shared_index == 5:
        jump n_S06
    if shared_index == 6:
        jump n_S07
    if shared_index == 7:
        jump n_S08
    if shared_index == 8:
        jump n_S09
    if shared_index == 9:
        jump n_S10
    jump ending

label n_S01:
    $ node = "S01"
    scene car with fade
    show hana seated at center with dissolve
    checkpoint
    narrator "Hana has given you a lift from the flooded bus stop. The car is now parked outside a late-night café. She leaves the heater on. \"You can come in, if you like."
    narrator "The rain has not made a convincing argument for going anywhere else.\""
    talk with hana:
        goal: Will you accept a little company, and on what terms?
        commit: ask
        max_turns: 18
        on_end: leave
        outcome welcome "A seat inside":
            rule: Player accepts company or asks about the café.
            $ rel.hana.ease = clamp(rel.hana.ease + 1, 0, 5)
            $ shared_index = 1
            jump n_S02
        outcome flirt "A possible coffee date":
            rule: Gentle reciprocal flirting and interest in seeing Hana again. She welcomes a future coffee, not instant love.
            when: rel.hana.status != "closed" and not rel.hana.repair and rel.mira.status != "exclusive" and rel.leila.status != "exclusive" and rel.tessa.status != "exclusive"
            $ rel.hana.spark = clamp(rel.hana.spark + 1, 0, 5)
            $ shared_index = 1
            jump n_S02
        outcome friend "Just company":
            rule: Player clearly expresses platonic interest; Hana accepts warmly.
            $ rel.hana.status = "friend"
            $ shared_index = 1
            jump n_S02
        outcome hurt "The heater goes quiet":
            rule: Player deliberately insults or pressures her after she names a boundary. Personal route pauses; the café remains public.
            $ rel.hana.trust = clamp(rel.hana.trust + -1, 0, 5)
            $ rel.hana.repair = true
            $ shared_index = 1
            jump n_S02
        outcome leave "Tomorrow, perhaps":
            rule: Player declines. Hana gives directions without guilt. The next afternoon June welcomes the player independently.
            $ shared_index = 1
            jump n_S02

label n_S02:
    $ node = "S02"
    scene cafe with fade
    show hana neutral at far_left with dissolve
    show mira neutral at left with dissolve
    show leila neutral at right with dissolve
    show tessa neutral at far_right with dissolve
    checkpoint
    narrator "The Spare Room smells of toast and wet coats. Mira loses a staring contest with the kettle. Leila moves her bag from a chair; Tessa checks that it will not wobble."
    narrator "Hana says, \"Nobody owns that seat. You are allowed to sit down.\""
    talk with hana, mira, leila, tessa:
        goal: Who interests you, and what kind of company feels comfortable?
        commit: ask
        max_turns: 18
        on_end: leave
        outcome settle "An invitation back":
            rule: Player joins conversation, shares a preference, or accepts quiet company.
            $ rel.hana.ease = clamp(rel.hana.ease + 1, 0, 5)
            $ rel.mira.ease = clamp(rel.mira.ease + 1, 0, 5)
            $ rel.leila.ease = clamp(rel.leila.ease + 1, 0, 5)
            $ rel.tessa.ease = clamp(rel.tessa.ease + 1, 0, 5)
            $ shared_index = 2
            jump n_S03
        outcome quiet "No performance required":
            rule: Player is shy, wants to listen, or prefers not to discuss personal history.
            $ shared_index = 2
            jump n_S03
        outcome leave "A small beginning":
            rule: Player leaves; an invitation remains without a guilt trip.
            $ shared_index = 2
            jump n_S03

label n_S03:
    $ node = "S03"
    scene cafe with fade
    show hana neutral at far_left with dissolve
    show mira neutral at left with dissolve
    show leila neutral at right with dissolve
    show tessa neutral at far_right with dissolve
    checkpoint
    narrator "June announces that she is retiring in six weeks. Hana could take a trial lease, but needs a sustainable plan. Mira proposes a farewell night called Last Light."
    narrator "June taps her notebook: \"An event is not a business plan, but it can be a useful rehearsal.\""
    talk with hana, mira, leila, tessa:
        goal: Do you want to participate, visit, or simply get to know these people?
        commit: ask
        max_turns: 18
        on_end: leave
        outcome help "A manageable promise":
            rule: Player offers a specific realistic task, without speaking for others.
            $ flags.volunteer = true
            $ stage = 1
            $ visits = 0
            jump hub
        outcome visit "Company counts":
            rule: Player will attend or offer moral support; no labor required.
            $ flags.guest = true
            $ stage = 1
            $ visits = 0
            jump hub
        outcome uncertain "An open invitation":
            rule: Player is undecided; nobody assigns work to them.
            $ stage = 1
            $ visits = 0
            jump hub
        outcome leave "Life outside the café":
            rule: Player declines involvement; personal visits remain possible.
            $ stage = 1
            $ visits = 0
            jump hub

label n_S04:
    $ node = "S04"
    scene cafe with fade
    show hana neutral at far_left with dissolve
    show mira neutral at center with dissolve
    show leila neutral at far_right with dissolve
    checkpoint
    narrator "Mira wants an eye-catching farewell poster. Hana wants the café to feel like a refuge, not a spectacle. Leila has a beautiful photograph, but several patrons have not agreed to publication."
    narrator "All three turn when you arrive; none wants a referee who simply picks his favorite."
    talk with hana, mira, leila:
        goal: Can publicity serve the café without making people into advertising?
        commit: ask
        max_turns: 18
        on_end: leave
        outcome consent "Ask the people in the picture":
            rule: Support explicit permission before publishing; use an empty-room image meanwhile.
            $ flags.consent_poster = true
            $ stage = 2
            $ visits = 0
            jump hub
        outcome quiet "A smaller invitation":
            rule: Choose illustrated posters and word of mouth; smaller attendance is acceptable.
            $ flags.quiet_poster = true
            $ stage = 2
            $ visits = 0
            jump hub
        outcome pressure "No vote over privacy":
            rule: Push to publish without consent. Leila refuses and uses a room photograph; relationship trust suffers only for those present.
            $ rel.hana.trust = clamp(rel.hana.trust + -1, 0, 5)
            $ rel.mira.trust = clamp(rel.mira.trust + -1, 0, 5)
            $ rel.leila.trust = clamp(rel.leila.trust + -1, 0, 5)
            $ flags.quiet_poster = true
            $ stage = 2
            $ visits = 0
            jump hub
        outcome leave "Their own compromise":
            rule: Let them decide: Hana draws a poster and Leila contributes an empty-room photograph.
            $ flags.quiet_poster = true
            $ stage = 2
            $ visits = 0
            jump hub

label n_S05:
    $ node = "S05"
    scene street with fade
    show hana neutral at far_left with dissolve
    show mira neutral at left with dissolve
    show leila neutral at right with dissolve
    show tessa neutral at far_right with dissolve
    checkpoint
    narrator "An evening in week three has become crowded: someone suggested a lakeside walk, someone mentioned a film, and the café needs chairs moved."
    narrator "Before anyone counts on you, there is time to say what you actually want to do."
    talk with hana, mira, leila, tessa:
        goal: Can you be clear about your time and interest without turning people into competitors?
        commit: ask
        max_turns: 18
        on_end: leave
        outcome clear "One honest plan":
            rule: Player chooses a visit or says they want an evening alone; no one is punished for not being chosen.
            $ flags.clear_plans = true
            $ stage = 3
            $ visits = 0
            jump hub
        outcome group "Ask, do not assume":
            rule: Propose a group outing. Only people who want it join; a private date is not silently converted.
            $ flags.group_evening = true
            $ stage = 3
            $ visits = 0
            jump hub
        outcome vague "No promises made":
            rule: Player remains uncertain. Everyone makes independent plans.
            $ flags.unbooked = true
            $ stage = 3
            $ visits = 0
            jump hub
        outcome leave "A free evening":
            rule: Player declines all invitations; no broken promise is invented.
            $ stage = 3
            $ visits = 0
            jump hub

label n_S06:
    $ node = "S06"
    scene hall with fade
    show hana neutral at far_left with dissolve
    show mira neutral at left with dissolve
    show leila neutral at right with dissolve
    show tessa neutral at far_right with dissolve
    checkpoint
    narrator "The first budget shows a problem: the café works only if Hana works too many hours and Tessa supplies free repairs. Leila has now received a residency offer."
    narrator "Mira suggests fewer opening nights; a monthly supper club is also possible. Nobody can preserve this summer unchanged."
    talk with hana, mira, leila, tessa:
        goal: Which future can these people sustain?
        commit: ask
        max_turns: 18
        on_end: leave
        outcome cafe "A smaller café":
            rule: Support three opening evenings, paid maintenance, a small menu, and time for Hana to illustrate. June agrees to consider the trial.
            $ flags.plan_cafe = true
            $ stage = 4
            $ visits = 0
            jump hub
        outcome club "Carry the room with you":
            rule: Support a monthly supper club at the community hall; allow the original café to close.
            $ flags.plan_club = true
            $ stage = 4
            $ visits = 0
            jump hub
        outcome rescue "The rescue is declined":
            rule: Promise impossible money, unpaid labor, or control. June declines; use a supper-club fallback until a viable proposal exists.
            $ flags.plan_club = true
            $ stage = 4
            $ visits = 0
            jump hub
        outcome leave "They choose sustainability":
            rule: Decline to decide for them. The women agree on a smaller supper club.
            $ flags.plan_club = true
            $ stage = 4
            $ visits = 0
            jump hub

label n_S07:
    $ node = "S07"
    scene cafe with fade
    show hana neutral at far_left with dissolve
    show mira neutral at left with dissolve
    show leila neutral at right with dissolve
    show tessa neutral at far_right with dissolve
    checkpoint
    narrator "At rehearsal, Tessa says she cannot stay late. Hana begins to offer to cover everything, stops, and looks at the timetable. Mira has forgotten a delivery."
    narrator "Leila admits she delayed mentioning her shortlist because she feared this exact conversation."
    talk with hana, mira, leila, tessa:
        goal: Can responsibility be shared without assigning blame to a convenient outsider?
        commit: ask
        max_turns: 18
        on_end: leave
        outcome share "Less work, better company":
            rule: Reduce the program, accept Tessa's limit, and address each missed task specifically.
            $ flags.sustainable_event = true
            $ stage = 4
            $ visits = 0
            jump hub
        outcome honest "Say what hurt":
            rule: Discuss Leila's delayed news without demanding that she refuse the residency. She apologizes for withholding it.
            $ flags.honest_rehearsal = true
            $ stage = 4
            $ visits = 0
            jump hub
        outcome blame "They will not pile on":
            rule: Try to blame one person for everything. The others defend fair treatment; the program is reduced anyway.
            $ rel.hana.trust = clamp(rel.hana.trust + -1, 0, 5)
            $ rel.mira.trust = clamp(rel.mira.trust + -1, 0, 5)
            $ rel.leila.trust = clamp(rel.leila.trust + -1, 0, 5)
            $ rel.tessa.trust = clamp(rel.tessa.trust + -1, 0, 5)
            $ flags.reduced_event = true
            $ stage = 4
            $ visits = 0
            jump hub
        outcome leave "A smaller rehearsal":
            rule: Leave without taking a task; the group completes a reduced plan.
            $ flags.reduced_event = true
            $ stage = 4
            $ visits = 0
            jump hub

label n_S08:
    $ node = "S08"
    scene hall with fade
    show hana neutral at far_left with dissolve
    show mira neutral at left with dissolve
    show leila neutral at right with dissolve
    show tessa neutral at far_right with dissolve
    checkpoint
    narrator "A storm cancels the outdoor part of Last Light. The community hall is available, but it is smaller. Mira holds a box of paper stars. \"Good news."
    narrator "We have accidentally invented intimacy.\" Hana laughs despite herself. There is still an evening to make."
    talk with hana, mira, leila, tessa:
        goal: What matters when the beautiful version of a plan fails?
        commit: ask
        max_turns: 18
        on_end: leave
        outcome adapt "A room full of warm light":
            rule: Help move a feasible indoor gathering, preserving guest consent and capacity.
            $ flags.event_warm = true
            $ stage = 5
            $ visits = 0
            jump hub
        outcome small "A table for a few":
            rule: Choose a small, quiet farewell. No attendance competition; the night still matters.
            $ flags.event_small = true
            $ stage = 5
            $ visits = 0
            jump hub
        outcome withdraw "Let others carry tonight":
            rule: Admit being overwhelmed and step away. The others host the reduced gathering.
            $ flags.event_small = true
            $ stage = 5
            $ visits = 0
            jump hub
        outcome leave "The light stays on":
            rule: Leave; the event happens offscreen without inventing the player's participation.
            $ flags.event_small = true
            $ stage = 5
            $ visits = 0
            jump hub

label n_S09:
    $ node = "S09"
    scene roof with fade
    show hana neutral at far_left with dissolve
    show mira neutral at left with dissolve
    show leila neutral at right with dissolve
    show tessa neutral at far_right with dissolve
    checkpoint
    narrator "The event is over. There are paper stars in someone's coat pocket and half a cake nobody can face yet. With the urgent work finished, invitations suddenly sound more personal."
    narrator "Someone asks what you are doing next week."
    talk with hana, mira, leila, tessa:
        goal: Which connections do you want to carry beyond this project?
        commit: ask
        max_turns: 18
        on_end: leave
        outcome continue "Time without an excuse":
            rule: Player wants to spend time with someone; private visits can now include explicit commitment.
            $ stage = 6
            $ visits = 0
            jump hub
        outcome friends "A circle, not a contest":
            rule: Player values friendships and does not want romance.
            $ stage = 6
            $ visits = 0
            jump hub
        outcome uncertain "No deadline for a feeling":
            rule: Player needs more time. An open-door ending remains possible.
            $ stage = 6
            $ visits = 0
            jump hub
        outcome leave "A quiet goodnight":
            rule: Leave without a declaration; no relationship is invented.
            $ stage = 6
            $ visits = 0
            jump hub

label n_S10:
    $ node = "S10"
    scene cafe with fade
    show hana neutral at far_left with dissolve
    show mira neutral at left with dissolve
    show leila neutral at right with dissolve
    show tessa neutral at far_right with dissolve
    checkpoint
    narrator "June hands over either the café keys or a recipe tin for the supper club. The sign comes down for cleaning, and for a moment the window looks unfamiliar."
    narrator "Then somebody moves your usual chair back into place. The future is smaller than a grand promise and much more real."
    talk with hana, mira, leila, tessa:
        goal: What do you want your next ordinary day with these people to look like?
        commit: ask
        max_turns: 18
        on_end: leave
        outcome finish "A life continuing":
            rule: Player describes a future, accepts the farewell, or asks to see the ending.
            jump ending
        outcome leave "Take the warmth with you":
            rule: Player leaves Bellweather; preserve only relationships actually agreed.
            jump ending

label n_H01:
    $ node = "H01"
    scene cafe with fade
    show hana neutral at center with dissolve
    checkpoint
    narrator "Hana sets down a drink, then catches herself. \"I remembered what you ordered. If it was a terrible first choice, this is your chance to escape it.\""
    talk with hana:
        goal: Does being remembered feel welcome?
        commit: ask
        max_turns: 18
        on_end: leave
        outcome connect "A little closer":
            rule: Thank her, clarify a preference, or ask about her own taste.
            $ rel.hana.trust = clamp(rel.hana.trust + 1, 0, 5)
            $ rel.hana.ease = clamp(rel.hana.ease + 1, 0, 5)
            $ rel.hana.progress += 1
            $ rel.hana.visits += 1
            jump hub
        outcome romance "Say what you mean":
            rule: Express interest in Hana herself; she admits she hoped you would return.
            when: rel.hana.status != "closed" and not rel.hana.repair and rel.mira.status != "exclusive" and rel.leila.status != "exclusive" and rel.tessa.status != "exclusive"
            $ rel.hana.trust = clamp(rel.hana.trust + 1, 0, 5)
            $ rel.hana.spark = clamp(rel.hana.spark + 1, 0, 5)
            $ rel.hana.status = "exploring"
            $ rel.hana.progress += 1
            $ rel.hana.visits += 1
            jump hub
        outcome friend "A friendship chosen":
            rule: Clarify friendship; she asks if she may join you on her break.
            $ rel.hana.trust = clamp(rel.hana.trust + 1, 0, 5)
            $ rel.hana.status = "friend"
            $ rel.hana.progress += 1
            $ rel.hana.visits += 1
            jump hub
        outcome uncertain "Room to decide":
            rule: Only when the PLAYER explicitly wants to wait or is unsure what they want. A character asking for more discussion is stay, not uncertain. Take time or sit quietly; she does not require a charming response.
            $ rel.hana.ease = clamp(rel.hana.ease + 1, 0, 5)
            $ rel.hana.progress += 1
            $ rel.hana.visits += 1
            jump hub
        outcome hurt "A boundary named":
            rule: Only for a clearly hurtful act, not awkwardness or disagreement. She names its impact; no instant forgiveness.
            $ rel.hana.trust = clamp(rel.hana.trust + -1, 0, 5)
            $ rel.hana.repair = true
            $ rel.hana.progress += 1
            $ rel.hana.visits += 1
            jump hub
        outcome leave "Another time":
            rule: Player clearly ends the visit. Respect the exit without a penalty.
            $ rel.hana.progress += 1
            $ rel.hana.visits += 1
            jump hub

