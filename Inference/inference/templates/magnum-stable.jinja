{# Magnum's documented Mistral format, with system text anchored in the first turn for KV prefix reuse. Text chat only. #}
{{- bos_token }}
{%- set system = messages[0]['content'] if messages[0]['role'] == 'system' else '' %}
{%- set turns = messages[1:] if messages[0]['role'] == 'system' else messages %}
{%- for message in turns %}
    {%- if message['role'] == 'user' %}
        {{- '[INST]' + (system + '\n\n' if loop.first and system else '') + message['content'] + '[/INST]' }}
    {%- elif message['role'] == 'assistant' %}
        {{- message['content'] + eos_token }}
    {%- else %}
        {{- raise_exception('Only alternating user/assistant text messages are supported') }}
    {%- endif %}
{%- endfor %}
